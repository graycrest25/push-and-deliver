# Server-only API origin. Never add a public prefix or expose it in next.config.
BASE_URL=https://api.example.test

# Optional exact hosts for private downloads from non-AWS S3-compatible storage.
# DOWNLOAD_HOSTS=storage.example.test

# Optional public OAuth audience, read on the server (no NEXT_ prefix).
# Also allow this client ID in backend GOOGLE_CLIENT_IDS and authorize the dashboard origin in Google.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
