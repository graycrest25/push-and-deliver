      "html": "<input class=\"ds-input\" aria-label=\"Search records\" placeholder=\"Search records\u2026\">",
      "css": ".ds-input{font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:14px;min-height:40px;padding:4px 12px;border:1px solid var(--input);border-radius:10px;background:var(--card);color:var(--foreground);caret-color:var(--primary);} .ds-input:focus-visible{outline:2px solid var(--ring);outline-offset:3px} .ds-input:hover{border-color:var(--ring);}"
    },
