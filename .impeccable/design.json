  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary Button as implemented in the shared workspace.",
      "html": "<button class=\"ds-button-primary\">Save changes</button>",
      "css": ".ds-button-primary{font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:14px;font-weight:500;border-radius:10px;min-height:36px;padding:8px 16px;cursor:pointer;transition:background-color 160ms,color 160ms,border-color 160ms;border:0;background:var(--primary);color:var(--primary-foreground);} .ds-button-primary:focus-visible{outline:2px solid var(--ring);outline-offset:3px} .ds-button-primary:hover{background:color-mix(in srgb,var(--primary) 90%,transparent);}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary Button as implemented in the shared workspace.",
      "html": "<button class=\"ds-button-secondary\">View summary</button>",
      "css": ".ds-button-secondary{font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:14px;font-weight:500;border-radius:10px;min-height:36px;padding:8px 16px;cursor:pointer;transition:background-color 160ms,color 160ms,border-color 160ms;border:0;background:var(--secondary);color:var(--secondary-foreground);} .ds-button-secondary:focus-visible{outline:2px solid var(--ring);outline-offset:3px} .ds-button-secondary:hover{background:color-mix(in srgb,var(--secondary) 80%,transparent);}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Outline Button as implemented in the shared workspace.",
      "html": "<button class=\"ds-button-outline\">Previous</button>",
      "css": ".ds-button-outline{font-family:\"Segoe UI\", -apple-system, BlinkMacSystemFont, Arial, sans-serif;font-size:14px;font-weight:500;border-radius:10px;min-height:36px;padding:8px 16px;cursor:pointer;transition:background-color 160ms,color 160ms,border-color 160ms;border:1px solid var(--border);background:var(--background);color:var(--foreground);} .ds-button-outline:focus-visible{outline:2px solid var(--ring);outline-offset:3px} .ds-button-outline:hover{background:var(--accent);color:var(--accent-foreground);}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
